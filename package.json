{
  "name": "@caesarloo/dsh-deepseek-account-vision",
  "version": "0.1.0",
  "description": "Give any main model DeepSeek-account vision in DeepSeek Harness: recognize images with DeepSeek-V4.1-Flash (deepseek-flash, 1017) through a deepseek_vision tool, and auto-transcribe attached images for any provider route. No API key.",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "author": {
    "name": "Caesar Loo",
    "email": "qizhen.lu@hotmail.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "vision",
    "multimodal",
    "image",
    "image-understanding",
    "ocr",
    "deepseek",
    "deepseek-flash",
    "deepseek-account"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\" && npm run check",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "check": "node scripts/check-no-bom.js && node scripts/check-leaks.mjs && node scripts/check-manifest.mjs",
    "check-leaks": "node scripts/check-leaks.mjs",
    "prepublishOnly": "npm test"
  }
}
